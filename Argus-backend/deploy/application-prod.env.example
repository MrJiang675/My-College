# 复制到仓库外的受控环境文件后填写；本文件不得写入真实凭据。
SPRING_PROFILES_ACTIVE=prod

# 准确的 Qoder Sites Origin，多个来源使用英文逗号分隔；不允许 *。
ARGUS_RAG_CORS_ALLOWED_ORIGINS=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

ES_HOST=
ES_PORT=
ES_SCHEME=
ES_INDEX_NAME=

ARGUS_RAG_JWT_SECRET=
ZHIPUAI_API_KEY=

# 跨站 HTTPS 默认 None + Secure；仅在受控同源 HTTP 测试时覆盖。
ARGUS_RAG_AUTH_REFRESH_COOKIE_SAME_SITE=None
ARGUS_RAG_AUTH_REFRESH_COOKIE_SECURE=true

# 可选联网搜索；生产默认关闭。
YOUCOM_SEARCH_ENABLED=false
YOUCOM_API_KEY=

# Low memory deployment
BACKEND_MEMORY_LIMIT=600m
POSTGRES_MEMORY_LIMIT=320m
MINIO_MEMORY_LIMIT=192m
ES_MEMORY_LIMIT=420m
ARGUS_ELASTICSEARCH_ENABLED=false
ARGUS_MAX_UPLOAD_SIZE_MB=10
ARGUS_MAX_REQUEST_SIZE_MB=12
JAVA_TOOL_OPTIONS="-Xms192m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC"
