# 服务器 A：数据库 / 检索 / 文件存储
POSTGRES_DB=argus_rag
POSTGRES_USER=root
POSTGRES_PASSWORD=set-real-password-via-env
POSTGRES_PORT=5433

ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms384m -Xmx384m
ELASTICVUE_PORT=8088

MINIO_ROOT_USER=set-real-key-via-env
MINIO_ROOT_PASSWORD=set-real-key-via-env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Low memory deployment
BACKEND_MEMORY_LIMIT=600m
POSTGRES_MEMORY_LIMIT=320m
MINIO_MEMORY_LIMIT=192m
ES_MEMORY_LIMIT=420m
ARGUS_ELASTICSEARCH_ENABLED=false
ARGUS_MAX_UPLOAD_SIZE_MB=50
ARGUS_MAX_REQUEST_SIZE_MB=60
JAVA_TOOL_OPTIONS="-Xms192m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC"
