# 服务器 B：应用 / 前端 / Ollama
SPRING_PROFILES_ACTIVE=dev
DASHSCOPE_API_KEY=your-dashscope-api-key
ARGUS_RAG_JWT_SECRET=replace-with-a-long-random-secret

# 指向服务器 A 的内网 IP
POSTGRES_HOST=10.0.0.11
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DB=argus_rag
POSTGRES_USER=root
POSTGRES_PASSWORD=set-real-password-via-env

MINIO_HOST=10.0.0.11
MINIO_INTERNAL_PORT=9000
MINIO_ROOT_USER=set-real-key-via-env
MINIO_ROOT_PASSWORD=set-real-key-via-env
MINIO_BUCKET=argus-rag-documents

ELASTICSEARCH_HOST=10.0.0.11
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

BACKEND_PORT=18080
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://backend:8080

OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=qllama/bge-small-zh-v1.5

# Low memory deployment
BACKEND_MEMORY_LIMIT=600m
POSTGRES_MEMORY_LIMIT=320m
MINIO_MEMORY_LIMIT=192m
ES_MEMORY_LIMIT=420m
ARGUS_ELASTICSEARCH_ENABLED=false
ARGUS_MAX_UPLOAD_SIZE_MB=50
ARGUS_MAX_REQUEST_SIZE_MB=60
JAVA_TOOL_OPTIONS="-Xms192m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC"

ZHIPUAI_API_KEY=REPLACE_WITH_REAL_KEY
ARGUS_RAG_CORS_ALLOWED_ORIGINS=https://frontend.example.org

# 全站生成/识图改用 DeepSeek；ZHIPUAI_API_KEY 仅用于 embedding-2（1024 维）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_SIMULATION_MODEL=deepseek-flash
DEEPSEEK_SIMULATION_THINKING_LEVEL=low
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_READ_TIMEOUT_SECONDS=90
DEEPSEEK_SIMULATION_MAX_TOKENS=8192
DEEPSEEK_SIMULATION_MAX_CONCURRENT=3
