# Copy this file to local-run.env in the same directory.
# local-run.env is ignored by Git and must contain the real values only on your machine.

SPRING_PROFILES_ACTIVE=prod

# Browser Origin has no trailing slash. Multiple origins use an English comma.
ARGUS_RAG_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://argus-insights-6ymqxlsdfpp.qoder.website

DB_HOST=106.14.125.122
DB_PORT=5432
DB_NAME=argus_rag
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_WITH_REAL_DB_PASSWORD

MINIO_ENDPOINT=http://106.14.125.122:9000
MINIO_ACCESS_KEY=REPLACE_WITH_REAL_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_REAL_MINIO_SECRET_KEY
MINIO_BUCKET=argus-rag-documents

ES_HOST=106.14.125.122
ES_PORT=9200
ES_SCHEME=http
ES_INDEX_NAME=argus_rag_document_chunks

# A new random signing key is generated on every start when this value is kept.
# Set a stable private value here if login sessions must survive backend restarts.
ARGUS_RAG_JWT_SECRET=AUTO_GENERATE_ON_START
ZHIPUAI_API_KEY=REPLACE_WITH_REAL_ZHIPUAI_API_KEY

# Local HTTP frontend settings. For public cross-site HTTPS use None + true.
ARGUS_RAG_AUTH_REFRESH_COOKIE_SAME_SITE=Lax
ARGUS_RAG_AUTH_REFRESH_COOKIE_SECURE=false

YOUCOM_SEARCH_ENABLED=false
YOUCOM_API_KEY=
