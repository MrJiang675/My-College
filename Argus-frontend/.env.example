# 显式留空：开发与生产均只提供前端预览，不发送后端请求。
# 后端就绪后，在 .env.production.local 或构建进程环境中设置真实 HTTPS 地址。
# 示例：VITE_API_BASE_URL=https://example.duckdns.org
# 也接受 https://example.duckdns.org/api；构建时统一为一个 /api 前缀。
VITE_API_BASE_URL=

# 仅用于 npm run dev，不会提供线上反向代理。
VITE_DEV_PROXY_TARGET=http://localhost:10001

# 单文件上传上限（MB）
VITE_MAX_UPLOAD_SIZE_MB=10
VITE_DEMO_PRESET_MODE=preset-first
